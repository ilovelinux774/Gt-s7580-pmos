# Boot text on the panel, not only on the UART. This tree has CONFIG_CMDLINE=""
# (checked against the vendor defconfig), so the boot image header cmdline plus
# whatever LK appends is the whole command line - nothing here can shadow a
# vendor argument, and nothing here is optional either.
#   console=ttyMSM0  keeps serial/RNDIS debugging alive; with two consoles
#                    /dev/console mirrors to both, so nothing is lost
#   console=tty0     the VT that fbcon now draws on the panel
#   loglevel=8       no "quiet": the boot messages are the point
#   fbcon=map:0      this SoC has no primary-display concept, and the vendor MDSS
#                    driver is what registers fb0, so bind the console to it
#   consoleblank=0   VT blanking drives the panel through mdss_fb, and on the
#                    downstream 3.18 driver a blanked console has stranded the
#                    backlight before; a text console that turns the screen off
#                    while you are reading it is worse than no text console
# fbcon=scrollback: keeps the console in a RAM buffer and redraws the
# visible window instead of panning: fb0 reports a virtual height of 2960
# (two screens), so a pan would move the text to a page the MDP pipe never
# scans out and the panel would freeze after the first screenful.
# No fbcon token is needed for the fix, so none is added here: the kernel patch
# (ci/j4primelte/kernel-fbcon.py) defers the bind by default, i.e. fb_open() is
# not evaluated while mdss_fb_probe() is inside register_framebuffer() and the
# notifier-driven takeover is suppressed, with the bind done at late_initcall().
# Binding during probe is what boot-looped runs #35 through #39, so it must not be
# something a device can opt into by accident; verify-images.py appends ",veto"
# instead, to build the control image. Keeping the device default vendor-shaped
# also means boot.img's cmdline here is byte-comparable with a known-good image,
# which is what makes a rollback provable.
deviceinfo_kernel_cmdline="console=ttyMSM0,115200n8 console=tty0 loglevel=8 fbcon=map:0,scrollback:256k consoleblank=0"
# Leave create_initfs_extra unset: this is a flat, single-partition rootfs.
deviceinfo_usb_network_function="rndis.usb0"

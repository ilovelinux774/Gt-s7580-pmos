# Boot-image offsets follow the historical j4primelte port, not GT-S7580.
deviceinfo_format_version="0"
deviceinfo_name="Samsung Galaxy J4+ SM-J415F"
deviceinfo_manufacturer="Samsung"
deviceinfo_codename="samsung-j4primelte"
deviceinfo_year="2018"
deviceinfo_arch="armv7"
deviceinfo_chassis="handset"
deviceinfo_external_storage="true"
deviceinfo_screen_width="720"
deviceinfo_screen_height="1480"
# Intentionally headless until the physical panel has been diagnosed.
deviceinfo_no_framebuffer="true"
deviceinfo_flash_method="heimdall-bootimg"
deviceinfo_generate_bootimg="true"
deviceinfo_header_version="0"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_offset_base="0x80000000"
deviceinfo_flash_offset_kernel="0x00008000"
deviceinfo_flash_offset_ramdisk="0x02000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x01e00000"
deviceinfo_flash_heimdall_partition_kernel="BOOT"
deviceinfo_flash_heimdall_partition_rootfs="SYSTEM"
deviceinfo_initfs_compression="gzip:best"
# Boot text on the panel, not only on the UART. This tree has CONFIG_CMDLINE=""
# (checked against the vendor defconfig), so the boot image header cmdline plus
# whatever LK appends is the whole command line - nothing here can shadow a
# vendor argument, and nothing here is optional either.
#   console=ttyMSM0  keeps serial/RNDIS debugging alive; with two consoles
#                    /dev/console mirrors to both, so nothing is lost
#   console=tty0     the VT that fbcon now draws on the panel
#   loglevel=8       no "quiet": the boot messages are the point
#   fbcon=map:0      this SoC has no primary-display concept, and the vendor MDSS
#                    driver is what registers fb0, so bind the console to it
#   consoleblank=0   VT blanking drives the panel through mdss_fb, and on the
#                    downstream 3.18 driver a blanked console has stranded the
#                    backlight before; a text console that turns the screen off
#                    while you are reading it is worse than no text console
deviceinfo_kernel_cmdline="console=ttyMSM0,115200n8 console=tty0 loglevel=8 fbcon=map:0 consoleblank=0"
# Leave create_initfs_extra unset: this is a flat, single-partition rootfs.
deviceinfo_usb_network_function="rndis.usb0"

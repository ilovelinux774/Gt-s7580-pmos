# The CI job compiles the pinned GPL-2.0 vendor sources with Android GCC 4.9,
# then packages those local outputs. This avoids claiming GCC 15 compatibility.
pkgname=linux-samsung-j4primelte
pkgver=3.18.140
pkgrel=0
pkgdesc="Samsung Galaxy J4+ downstream kernel, USB bring-up configuration"
url="https://github.com/ProjectMedusaAndroid/android_kernel_samsung_msm8917_Q"
arch="armv7"
license="GPL-2.0-only"
options="!check !strip !tracedeps !archcheck pmb:cross-native"
depends="postmarketos-base-downstream"
source="zImage-dtb kernel.release kernel.config kernel-modules.tar.gz"

package() {
	install -Dm644 "$srcdir/zImage-dtb" "$pkgdir/boot/vmlinuz"
	install -Dm644 "$srcdir/kernel.release" \
		"$pkgdir/usr/share/kernel/samsung-j4primelte/kernel.release"
	install -Dm644 "$srcdir/kernel.config" "$pkgdir/boot/config-samsung-j4primelte"
	mkdir -p "$pkgdir/usr/lib"
	# abuild extracts .tar.gz sources into srcdir before package().
	cp -a "$srcdir/modules" "$pkgdir/usr/lib/"
}

# Generated by `pmbootstrap checksum` after the kernel build, not bypassed.
sha512sums=""

+/*
+ * J415F EXPERIMENTAL diagnostic, not a confirmed XPU or boot fix.
+ *
+ * A Samsung T380/T385 MSM8917 mainline port reported a silent failure when
+ * the ARM32->AArch64 monitor handoff came from the 0x8f600000 loader region.
+ * Its LK workaround relocates both the parameter block and SMC instruction to
+ * low HLOS RAM. J415F has not yet shown that this is its failure mechanism.
+ * See https://github.com/akprof2000/samsung-t385-postmarketos/blob/main/lk2nd/0001-samsung-xpu-smc-stub.patch
+ * and https://github.com/sapphicdisaster/t380-linux/blob/main/documentation/bootloader_and_trustzone.md
+ *
+ * The addresses below lie inside the primary loader's original LK load buffer,
+ * which has already been relocated by lk2nd, and below the second Image at
+ * 0x80080000. Actual firmware access permissions remain hardware-untested.
+ * Called only from boot_linux after arch_disable_cache(UCACHE) and MMU-off.
+ */
+#define J4_HLOS_PARAM_ADDR 0x80055000u
+#define J4_HLOS_STUB_ADDR  0x80056000u
+#define J4_PMSG_ZONE_ADDR  0x860c0000u
+#define J4_PSTORE_SIG      0x43474244u
+#define J4_MARKER_MAX      192u
+
+/* Commit a bounded vendor-style persistent-RAM ring, signature last.
+ * This deliberately replaces the OLD VOLATILE pmsg ring, not BOOT/rootfs,
+ * dmesg or console. Recovery layout and RAM retention are unconfirmed.
+ * The companion diagnostic DTB reserves this quarter separately so that
+ * mainline ramoops cannot initialize it as ftrace and erase the marker.
+ */
+static void j4_diag_stage(const char *message)
+{
+	volatile uint32_t *header = (volatile uint32_t *)J4_PMSG_ZONE_ADDR;
+	volatile uint8_t *data = (volatile uint8_t *)(J4_PMSG_ZONE_ADDR + 12u);
+	uint32_t n = 0;
+
+	header[0] = 0;
+	__asm__ volatile("dsb sy" ::: "memory");
+	while (n < J4_MARKER_MAX && message[n]) {
+		data[n] = message[n];
+		n++;
+	}
+	header[1] = n;
+	header[2] = n;
+	__asm__ volatile("dsb sy" ::: "memory");
+	header[0] = J4_PSTORE_SIG;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Copy an ARM-state SMC stub to HLOS RAM. Arguments are literal words, so
+ * there is no compiler-dependent literal pool. Unlike the T385 example this
+ * returns safely on SMC failure and follows the original retry-on-1 policy.
+ * r4-r6/lr are saved/restored if the monitor returns, per the AAPCS. On a
+ * successful 32->64 handoff this function never returns. */
+static uint32_t j4_hlos_smc(uint32_t x0, uint32_t x1, uint32_t x2,
+			    uint32_t x3, uint32_t x4, uint32_t x5)
+{
+	volatile uint32_t *s = (volatile uint32_t *)J4_HLOS_STUB_ADDR;
+	s[0]  = 0xe92d4070u; /* push {r4,r5,r6,lr} */
+	s[1]  = 0xe59f0024u; /* ldr r0, [pc, #36] */
+	s[2]  = 0xe59f1024u; /* ldr r1, [pc, #36] */
+	s[3]  = 0xe59f2024u; /* ldr r2, [pc, #36] */
+	s[4]  = 0xe59f3024u; /* ldr r3, [pc, #36] */
+	s[5]  = 0xe59f4024u; /* ldr r4, [pc, #36] */
+	s[6]  = 0xe59f5024u; /* ldr r5, [pc, #36] */
+	s[7]  = 0xe3a06000u; /* mov r6, #0 */
+	s[8]  = 0xe1600070u; /* smc #0 */
+	s[9]  = 0xe3500001u; /* cmp r0, #1 */
+	s[10] = 0x0afffffcu; /* beq to s[8] */
+	s[11] = 0xe8bd8070u; /* pop {r4,r5,r6,pc} */
+	s[12] = x0;
+	s[13] = x1;
+	s[14] = x2;
+	s[15] = x3;
+	s[16] = x4;
+	s[17] = x5;
+	__asm__ volatile("dsb sy\n\tisb" ::: "memory");
+	return ((uint32_t (*)(void))J4_HLOS_STUB_ADDR)();
+}

# Kernel 5.10 bring-up for the Samsung Galaxy J4+ (SM-J415F, j4primelte).
#
# Everything below is pinned. The point of this file is that a build can be
# reproduced from it alone, and that changing the tree is a one-line, reviewable
# diff instead of an invisible `git clone` inside a workflow.
#
# WHY 5.10
#   systemd upstream README: kernel < 5.10 is "not supported at all" (the
#   minimum baseline is 5.10) and kernel < 5.14 sets the old-kernel taint.
#   cgroup v1 is refused since systemd v256. So the *kernel version* is a hard
#   requirement of the init system, independent of userspace bitness.
#
# WHY NOT ARM32
#   systemd does not care whether the kernel is 32- or 64-bit. Every public
#   5.10 base with real Qualcomm msm8917/8937 support that we could find is
#   arm64 (the SoC is ARMv8-A and boots fine as aarch64). An armv7 5.10 would
#   mean back-porting an entire SoC port into arch/arm, which is strictly more
#   work for strictly less hardware support. The armv7 part that matters - the
#   Alpine/pmOS userspace - is kept by building the kernel with CONFIG_COMPAT
#   so a 32-bit rootfs runs on top of it.
#
# STATUS
#   No tree in this file has been verified to boot on the phone yet. The
#   workflow refuses to run a tree whose header does not match what is expected
#   (see verify-tree.sh), so a wrong pin fails in CI instead of on the device.
#
# --- primary candidate -------------------------------------------------------
# Qualcomm CAF msm-5.10 as mirrored by CodeLinaro. arm64 only.
J4_K510_KERNEL_URL='https://github.com/CodeLinaro-mirror/la_kernel_msm-5.10.git'
J4_K510_KERNEL_BRANCH='aosp-new/android12-5.10/android12-5.10-2022-07'
J4_K510_KERNEL_COMMIT='b3898383081097524bf3fdd905f96ffc97d0f8ee'
# Expected Makefile version, checked before the build starts.
J4_K510_KERNEL_VERSION='5.10'
# Required path, relative to the tree root. Proves we got the tree we think.
J4_K510_KERNEL_PROBE='arch/arm64/Kconfig.platforms'

# Toolchain. Google's aarch64 GCC (r383902 for android11/12 releases) is the
# known-good compiler for this generation of Qualcomm trees; LLVM also works but
# needs a different wrapper, so GCC is pinned first.
J4_K510_TOOLCHAIN_URL='https://github.com/LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9.git'
J4_K510_TOOLCHAIN_BRANCH='lineage-19.1'
J4_K510_TOOLCHAIN_COMMIT='5e030eafe024784a73cdf47e6936ac0dbfc763dc'
J4_K510_CROSS_COMPILE='aarch64-linux-android-'

# Defconfig, relative to arch/arm64/configs. Empty means "discover it": the
# workflow looks for a j4primelte/scuba/khaje defconfig and fails loudly if the
# discovery is ambiguous rather than silently building the wrong board.
J4_K510_DEFCONFIG=''

# --- donor: the phone's own known-good boot image ---------------------------
# Never a GT-S7580 image. The ramdisk supplies the pmOS initramfs (which already
# finds the installed rootfs by UUID); only the kernel payload is replaced.
J4_K510_DONOR_URL='https://github.com/ilovelinux774/Gt-s7580-pmos/releases/download/j4-39/boot-37-KNOWN-GOOD-rollback.img'
J4_K510_DONOR_SHA256='3ba9fa06e0d410dbd2e1f8e700090ab1eebc68f491a40dcfde53d805373ae80e'

# Must match the donor boot header, because the Samsung loader reads the boot
# header and Overwrites-with-these addresses; anything else is a guess.
J4_K510_BOOT_KERNEL_ADDR='0x00008000'
J4_K510_BOOT_RAMDISK_ADDR='0x02000000'
J4_K510_BOOT_TAGS_ADDR='0x00000100'
J4_K510_BOOT_SECOND_ADDR='0x00f00000'
J4_K510_BOOT_PAGE_SIZE='2048'

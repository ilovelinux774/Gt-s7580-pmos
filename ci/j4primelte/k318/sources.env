# Candidate ARM64 J4+ kernel source for the Build 2 systemd backport prototype.
# This is the public LuckyKernel 3.18.120-A11 tree, not a proven byte-for-byte
# match for the uploaded Build 2 image. Keep the existing Build 2 image as the
# hardware reference and do not replace it with a prototype artifact.
J4_K318_KERNEL_REPO='https://github.com/wonderful-mobile/android_kernel_samsung_msm8917_64.git'
J4_K318_KERNEL_REF='3.18.120-A11'
J4_K318_KERNEL_COMMIT='4fcc1090e5e07e7ccf877793e1bfe151641424bf'
J4_K318_KERNEL_VERSION='3.18.120'
J4_K318_DEFCONFIG='j4primelte_defconfig'

# Uploaded Build 2 boot image used to extract the actual running kernel config.
J4_BUILD2_BOOT_SHA256='5e5a44feaf70a33693b3559eb42ba8bf0d5b4f4bfe3521f99004adfca8e55322'
J4_BUILD2_CONFIG_SHA256='50ec2b197be1286628fca62cabe9bd952fcfcca2754476537deae9e96a40dfd9'
J4_BUILD2_DTB_SHA256='6fca7cf5b5bbb142afb99c5e48dadaa4129ee961a06232d10089dd91710ff993'

# This tree is a kernel backport prototype, not the current Arch rootfs target.
# Current Arch/systemd is paired with the 7.1.3 mainline kernel in k510/.

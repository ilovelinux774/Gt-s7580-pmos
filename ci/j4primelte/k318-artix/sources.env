# Artix's OpenRC fork includes openrc-init, unlike the older upstream 0.40.x
# release used by Artix's x86_64 package recipe. Pin the exact AArch64 source.
ARTIX_OPENRC_REPO='https://github.com/artix-linux/openrc.git'
ARTIX_OPENRC_COMMIT='a25ccbd8f2d5198e1b9f63d6ae944635e2ff64e7'
ARTIX_OPENRC_VERSION='0.44'
ARTIX_OPENRC_ARCHIVE_SHA256='c39d2b9d387ec84337549c524bc5c611a00a3ae50650c6f886ff94cc2303cb72'

# The source archive URL is codeload.github.com/artix-linux/openrc/tar.gz/$commit.
# The checksum above is for the exact GitHub-generated tar archive.

# Use the J4's display-fixed #39 postmarketOS BOOT as the Artix donor. Do not
# substitute the #37 rollback image: its framebuffer-console path can stall at
# mdss_fb_probe before initramfs userspace starts.
J4_ARTIX_PMO_DONOR_URL='https://github.com/ilovelinux774/Gt-s7580-pmos/releases/download/j4-39/boot.img'
J4_ARTIX_PMO_DONOR_SHA256='46cacb8884a4a41afd8bd13cbe0e167eede30c7fbbf50067e60433c7c1251849'

# Arch Linux ARM aarch64 rootfs; install it on a separate ext4 filesystem and
# label that filesystem ARCHROOT before booting the generated kernel image.
# Arch Linux ARM serves this upstream tarball over HTTP; authenticate its
# detached signature with the pinned upstream keyring rather than trusting TLS.
# Keyring source: archlinuxarm/PKGBUILDs@077d87604e5e55688d9b241b4a5b2b1ab47e8ab5,
# core/archlinuxarm-keyring/archlinuxarm.gpg (SHA-256 pinned below).
ARCHLINUXARM_ROOTFS_URL='http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz'
ARCHLINUXARM_BUILDER_FINGERPRINT='68B3537F39A313B3E574D06777193F152BDBE6A6'
ARCHLINUXARM_KEYRING_SHA256='6ce771e853f04a38a5b533cb33e61f877b9b06b58b6db051eb8a15d737a2332f'
ARCHLINUXARM_ROOT_LABEL='ARCHROOT'
# The selected 2400 MiB image leaves 96 MiB on the user-reported 2496 MiB /system.
# Recheck the phone's live partition size before writing this image.
ARCHLINUXARM_ROOTFS_IMAGE_MIB='2400'
J4_ARCH_SYSTEM_PARTITION_BYTES='2617245696'

# Pinned sources for the mainline J4+ kernel. Sourced by build-mainline.sh.
#
# The base is the msm89x7 tree maintained for postmarketOS-style bring-up: it is
# a 7.1.3 rebase with the MSM8917/MSM8937 support that the phone needs, including
# the generated DSI panel drivers (linux-mdss-dsi-panel-driver-generator output),
# which is where the J4+ panel driver came from.
#
# Pin the commit, not the branch: the branch moves, and a mainline kernel that
# boots is a property of one commit plus the files in ci/j4primelte/mainline/.
J4_MAINLINE_REPO='https://github.com/msm89x7-mainline/linux'
J4_MAINLINE_BRANCH='msm89x7/7.1.3'
J4_MAINLINE_SHA='15c904f9ffe013d23bbd71d3d2113b4e8ef12687'
J4_MAINLINE_KERNEL_RELEASE='7.1.3'

# Device-tested rollback donor: release j4-39's #37 known-good boot image.
# It targets the installed p47 rootfs UUID and contains the pmOS ARM32 initramfs.
# Never fall back to the unrelated GT-S7580 boot.img at the repo root.
J4_MAINLINE_DONOR_URL='https://github.com/ilovelinux774/Gt-s7580-pmos/releases/download/j4-39/boot-37-KNOWN-GOOD-rollback.img'
J4_MAINLINE_DONOR_SHA256='3ba9fa06e0d410dbd2e1f8e700090ab1eebc68f491a40dcfde53d805373ae80e'
J4_MAINLINE_DONOR_ROOT_UUID='86e7262b-b628-4b89-8a6e-e96ef9b1aab6'

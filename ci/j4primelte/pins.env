# Pinned inputs for the J4+ (SM-J415F) bring-up.
#
# Everything here is a fact measured from an artifact that previously booted on
# the handset, not a preference. If one of these hashes changes, the meaning of
# every image built by this repository changes with it.

# ---------------------------------------------------------------------------
# The reference BOOT image
# ---------------------------------------------------------------------------
# This is the Medusa ARM64 image whose initramfs debug shell was reached on the
# phone, and the image the owner re-supplied. It is the project's anchor: every
# new BOOT image must keep its layout, its kernel payload and its appended DTB,
# and may only change the initramfs and the command line.
J4_REFERENCE_BOOT_URL='https://github.com/ilovelinux774/Gt-s7580-pmos/releases/download/j4-medusa64-fbdev-parent-debug-1/medusa64-fbdev-parent-debug-UNTESTED.img'
J4_REFERENCE_BOOT_SHA256='0f9f643194f0aead8e36a2e5242cb0af9a748e5103dad67787fa3bc06ea37e3f'
J4_REFERENCE_BOOT_BYTES='17510400'

# ---------------------------------------------------------------------------
# What is inside that image (see: j4boot.py inspect --reference)
# ---------------------------------------------------------------------------
J4_KERNEL_PAYLOAD_SHA256='65081abb3786647655a3c6ffcbd8865e00f9d7b0385570b30d907155ac5b24d8'
J4_KERNEL_IMAGE_GZ_SHA256='0e729bf52bfbb659e4d02f0f20dc2ec0687a15405bcdf1a684ab8bc4a8b7b557'
J4_KERNEL_IMAGE_SHA256='26dd1eef209cd462f5bbecd1dd76ed34e4cc41cfc1330a912af8abc9e32e470e'
J4_KERNEL_IMAGE_BYTES='26807808'
J4_KERNEL_VERSION='3.18.120-j4-medusa64-debug+'
J4_DTB_SHA256='6fca7cf5b5bbb142afb99c5e48dadaa4129ee961a06232d10089dd91710ff993'
J4_DTB_BYTES='241611'
J4_DTB_MODEL='Samsung J4PRIMELTE SEA OPEN PROJECT Rev06'
J4_DTB_MSM_ID='0x12f,0x0,0x134,0x0,0x135,0x0'
J4_DTB_BOARD_ID='0x8,0x6'
J4_DTB_PMIC_ID='0x10019,0x0,0x0,0x0'
J4_PMOS_RAMDISK_GZ_SHA256='f2c18fcea31fed9a1af3eb5bec700b0d8f1d5006382537a394a5ea2c32b68ef6'
J4_PMOS_ROOT_UUID='86e7262b-b628-4b89-8a6e-e96ef9b1aab6'

# ---------------------------------------------------------------------------
# Boot header geometry (Android v0, as the reference image stores it)
# ---------------------------------------------------------------------------
J4_BOOT_PAGE_SIZE='2048'
J4_BOOT_HEADER_VERSION='0'
J4_BOOT_KERNEL_ADDR='0x80080000'
J4_BOOT_RAMDISK_ADDR='0x83600000'
J4_BOOT_SECOND_ADDR='0x80f00000'
J4_BOOT_TAGS_ADDR='0x83400000'
# /dev/block/mmcblk0p23 on the observed handset.
J4_BOOT_PARTITION_BYTES='33554432'
J4_SYSTEM_PARTITION_BYTES='2617245696'

# ---------------------------------------------------------------------------
# Userspace: ARMtix (Artix Linux for aarch64), OpenRC
# ---------------------------------------------------------------------------
# Artix, not Arch, because Arch is systemd-only and this project wants an init
# that runs without a modern kernel's assumptions. ARMtix publishes a rootfs
# tarball per init system; the OpenRC one is what boots here.
#
# Why glibc is acceptable at all: glibc's "kernel too old" check reads
# .note.ABI-tag, which is set by --enable-kernel but can never go below the
# architecture minimum. For aarch64 that minimum is 3.7.0, and Arch Linux ARM
# (whose glibc ARMtix uses) passes no --enable-kernel, so its binaries carry
# 3.7.0. 3.7.0 <= the phone's 3.18.120. See ci/j4primelte/README-rootfs.md.
#
# The tarball is ~1 GiB compressed and is not committed. The tag is the release
# date ARMtix uses; bump it (and the hash) deliberately, not automatically.
ARTIX_IMAGE_URL='https://armtix.artixlinux.org/images/armtix-openrc-20260921.tar.xz'
ARTIX_IMAGE_SHA256='250abf136930f5c7d4ba1a6d2b9b56f6b32acb072e05ccb4b6ab7aa23b834699'
ARTIX_IMAGE_BYTES='0'  # not recorded: the mirror does not publish sizes we trust
ARTIX_INIT='openrc'

# Artix's OpenRC tree. Not fetched by the build any more -- the ARMtix image
# ships openrc-init already, and this repository does not rebuild userspace
# packages. It stays pinned because it answers "which openrc-init is in the
# image": the fork Artix builds from, so the init's behaviour is reproducible
# even though the tarball is a rolling release.
# Source: https://github.com/artix-linux/openrc
ARTIX_OPENRC_URL='https://codeload.github.com/artix-linux/openrc/tar.gz/a25ccbd8f2d5198e1b9f63d6ae944635e2ff64e7'
ARTIX_OPENRC_COMMIT='a25ccbd8f2d5198e1b9f63d6ae944635e2ff64e7'
ARTIX_OPENRC_ARCHIVE_SHA256='c39d2b9d387ec84337549c524bc5c611a00a3ae50650c6f886ff94cc2303cb72'

# The label the initramfs hook searches for. ARTIXROOT says what it is; the
# hook takes it from --root-label, this is only the default.
ARTIX_ROOT_LABEL='ARTIXROOT'
ARTIX_ROOTFS_IMAGE_MIB='2400'

# The kernel this userspace has to survive.
ARTIX_KERNEL_FLOOR_ALLOWED='3.18.120'
